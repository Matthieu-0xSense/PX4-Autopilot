#!/bin/sh
#
# @name 0xSense Ackermann Rover
#
# @type Rover
# @class Rover
#
# Production airframe for the 0xSense rover. Bakes all factory defaults so a
# freshly flashed FMU boots ready for the per-unit provisioning step (GPS
# antenna offset, serial number) — see scripts/provision_fmu.py.
#
# `param set-default` = factory value, only applied when user has not set the
# parameter. Survives `param reset`, unlike `param set` which is overwritten.
#
# To install on the host PX4 tree:
#   1. Copy this file to:
#        ROMFS/px4fmu_common/init.d/airframes/51003_ackermann_0xsense
#   2. Register it in:
#        ROMFS/px4fmu_common/init.d/airframes/CMakeLists.txt
#   3. Rebuild firmware:
#        make px4_fmu-v6xrt_default EXTERNAL_MODULES_LOCATION=<repo>/external_modules
#   4. Flash. After first boot:
#        param set SYS_AUTOSTART 51003
#        reboot
#
. ${R}etc/init.d/rc.rover_ackermann_defaults

set VEHICLE_TYPE rover_ackermann

# Vehicle-identity + CAN params. Use `param set-default` (not `param
# set`) — `param set` forces the value at every boot, which on
# `reboot_required: true` params like UAVCAN_ENABLE trips the
# reboot-required handler whenever the saved/factory value differs,
# breaking QGC's initial param handshake. `set-default` only changes
# the param when no saved user value exists, so fresh-flashed FMUs
# get rover defaults, and units with stale saves can be re-targeted
# via `scripts/provision_fmu.py` (one-shot `param set + save`).
param set-default MAV_TYPE      10
param set-default CA_AIRFRAME   5
param set-default CA_R_REV      1
# UAVCAN must be OFF. rover_can_bridge already drives FlexCAN1 via
# SocketCAN raw (11-bit IDs to VCU). Co-resident uavcan module = two
# clients on the same FlexCAN TX ring → NuttX imxrt_flexcan.c is not
# reentrant for that → AHB imprecise bus fault, FMU reboots, QGC drops.
# Decoded crash: pc imxrt_txpoll @ flexcan.c:797, lr imxrt_txringfull
# @ flexcan.c:539, abfsr=0x4. If DroneCAN sensors are added later,
# they must move to a free FlexCAN instance (CAN2/3), never share CAN1
# with the bridge.
param set-default UAVCAN_ENABLE 0
param set-default CAN_BRIDGE_EN 1

# ── Ackermann geometry (0xSense rover — vehicle data sheet 2026-06-16) ──
# Length 2.825 m, track (voie) 1.500 m, wheel Ø 0.86 m, reduction 150.
# Max steer 75° (1.31 rad) -> min turn radius wb/tan(75°) ≈ 2.825/3.73 ≈ 0.76 m
# (near pivot — the rover U-turns within a headland). 30°/5 m was the wrong,
# too-wide model that could not U-turn (spin/fan at line ends).
# CONFIRM RA_WHEEL_BASE is the axle-to-axle empattement (data row is
# "Longueur" = length); if the axle spacing is less, scale it down.
param set-default RA_WHEEL_BASE     2.825   # front-rear axle [m] - CONFIRM empattement
param set-default RA_MAX_STR_ANG    1.31    # max steer [rad] = 75 deg (was 30 deg)

# ── Attitude (heading) control ─────────────────────────────────────────
# Outer heading P: yaw_rate_cmd = RO_YAW_P × heading_err, clamped to
# RO_YAW_RATE_LIM. DEFAULT IS 0.0 => zero steering (silent — runSanityChecks
# does not flag it). MUST be set. See docs/rover_tuning.md.
param set-default RO_YAW_P          1.0     # 2.5T SITL sweep: softer loop, osc 0.196->0.053

# ── Rate control ───────────────────────────────────────────────────────
param set-default RO_YAW_RATE_P     0.3
param set-default RO_YAW_RATE_I     0.02
# Physical max yaw-rate = v·tan(str)/wb = 1.36·tan75°/2.825 ≈ 1.8 rad/s ≈ 103°/s.
# Cap below that for smooth line-tracking; raise toward 100 for faster headland
# turns. Code clamps to min(physical, this).
param set-default RO_YAW_RATE_LIM   90      # [deg/s] near phys max -> uses full steer
param set-default RO_YAW_ACCEL_LIM  80      # [deg/s2] snap into the turn

# ── Speed control (4.9 km/h field rover) ───────────────────────────────
param set-default RO_MAX_THR_SPEED  1.4     # top speed at full throttle [m/s] (4.9 km/h)
param set-default RO_SPEED_LIM      1.3     # cruise [m/s]
# Speed loop must be closed, not pure feed-forward. With P/I≈0 the throttle is
# just speed_sp/RO_MAX_THR_SPEED; if the real VCU's throttle->speed gain differs
# from RO_MAX_THR_SPEED the rover over/under-speeds with no correction -> turn
# radius v/ω diverges -> pure-pursuit orbits. Non-zero P/I regulates to setpoint.
# Starting values from the HITL fix (2026-06-18); tune on the real vehicle.
param set-default RO_SPEED_P        0.5
param set-default RO_SPEED_I        0.5
param set-default RO_ACCEL_LIM      0.5
param set-default RO_DECEL_LIM      0.5
# Corner slowdown: how hard PX4 drops speed at sharp transitions so the rover
# can tuck into the turn (radius r = v/omega; lower v -> tighter + steering FF
# atan(w*wb/v) uses more of the 75 deg). Reaches the controller AND SIH, unlike
# the CAN ROV_SPD_TURN zone which only slows the VCU. Internally clamped 0..1.
param set-default RO_SPEED_RED      2.5

# ── Logging ────────────────────────────────────────────────────────────
# Always log from boot to shutdown so a flaky bring-up can be replayed at
# logs.px4.io. SDLOG_MODE=2 = full-time. Default profile = sensors + nav +
# control + mission. SD wear is acceptable on bench / pre-prod; revisit
# (-> SDLOG_MODE=0, armed-only) once the rover is in fleet operation.
param set-default SDLOG_MODE       2
# SDLOG_PROFILE is a bitfield: 1=default, 2=estimator-replay, 32=debug.
# Default (1) is enough for bring-up; add 2 / 32 if needed for deeper
# investigation. 35 is heavy on SD bandwidth.
param set-default SDLOG_PROFILE    1
# SDLOG_BACKEND bitmask: 1=SD card, 2=mavlink. Must be non-zero or the logger
# never starts (bench SD-bus test left it 0 -> no logs). 1 = SD only.
param set-default SDLOG_BACKEND    1

# ── Autonomous-only (no RC, no battery monitor yet) ────────────────────
# Rover is driven by companion + VCU, never by RC sticks. Disable RC input
# entirely so QGC stops flagging "Radio setup required" and so the
# commander never waits for a stick input to arm.
param set-default COM_RC_IN_MODE    4

# Battery hardware not yet selected (rover-class, big pack TBD). Bypass
# the supply check so QGC stops flagging "Power setup required" and the
# commander does not refuse to arm on the bench. Revisit once the power
# module is chosen — set BAT1_N_CELLS / BAT1_V_DIV / BAT1_A_PER_V /
# BAT1_SOURCE / BAT1_CAPACITY and remove this CBRK.
param set-default CBRK_SUPPLY_CHK   894281

# Allow arming while USB is connected. Bench testing requires this; for
# field flight, power off USB anyway.
param set-default CBRK_USB_CHK      197848

# Allow arming with a hardfault/watchdog file present on the SD card. Bench
# units accumulate these from prior crashes; without this the commander
# refuses to arm. Default firmware value is 1 (deny). Clear the SD card files
# once root cause is understood.
param set-default COM_ARM_HFLT_CHK  0

# Disable the imbalanced-propeller failure detector. It is a multirotor check;
# a ground rover has no propellers, so it false-triggers at arm -> repeated
# CRITICAL "Imbalanced propeller" events that flooded the mavlink-eth task and
# rebooted the FMU. 0 = disabled. Correct for production (rover never has props).
param set-default FD_IMB_PROP_THR   0

# ── Pure pursuit ───────────────────────────────────────────────────────
# Lookahead L = GAIN × speed, clamped [MIN,MAX]. Long enough to track the line
# smoothly, short enough to make the tight headland U-turn (turn radius
# ~0.76 m). See docs/rover_tuning.md.
# Long lookahead suits the heavy 2.5T vehicle (plan turns further ahead, low
# oscillation). NOTE: tuned on SITL which turns WIDER than the real 0.76 m
# rover (SIH stability cap) -> re-check on the real robot; it may want shorter.
param set-default PP_LOOKAHD_GAIN   2.0
param set-default PP_LOOKAHD_MAX    12
# Real-robot turn radius ~0.76 m; lookahead floor just above it (1.3x margin).
# SITL sweep on test_boustro_spawn (sih.cpp tan_delta cap raised to the real
# radius) picked 1.0: straight-line xte 0.18 m, no orbit, lowest oscillation;
# 0.8 oscillates more, >=1.5 cuts corners. Was 5.0 (old wide ~1.9 m SIH radius)
# which aimed past corners and circled.
param set-default PP_LOOKAHD_MIN    1.0

# Waypoint acceptance: drive TO the turn waypoint, do not cut the corner wide.
# RA_ACC_RAD_MAX caps the auto corner-cut growth (scaled off min turn radius).
# NAV_ACC_RAD must exceed the line-tracking crosstrack, else the rover flies past
# a straight-row waypoint at its normal crosstrack offset, never enters the circle,
# the navigator never advances, and the ROV_MISS latch aborts (HITL 2026-06-18:
# crosstrack ~0.56 m > old 0.5 m radius -> missed WP14). Keep radius > crosstrack.
param set-default NAV_ACC_RAD       1.0
param set-default RA_ACC_RAD_GAIN   2
param set-default RA_ACC_RAD_MAX    2.0

# ── MAVLink instance 2 = companion over UDP/Ethernet @ 14550 ──
# Ethernet IP itself is NOT a PX4 parameter — it lives in
# /fs/microsd/net.cfg (see configs/net.cfg in this repo, dropped onto
# each rover's SD card alongside extras.txt). MAV_2_CONFIG=1000 is
# already in rc.board_defaults.
param set-default MAV_2_CONFIG    1000
# MODE 0 = Normal (NOT 2/Onboard). This is the upstream-hardfault MITIGATION.
# The Onboard stream set (ATTITUDE 100Hz, HIGHRES_IMU 50Hz, LOCAL_POSITION/
# ODOMETRY 30Hz, ...) drives a wild-write hardfault in the MAVLink stream-send /
# uORB Subscription::update path — reproduced on pristine px4_fmu-v6xrt_default at
# c4abeed3a4 AND latest main e24cda2fd9 (../px4_issue_attachments/, px4_changes.md).
# Onboard crashed in ~8 min under load; Normal's ~10x lighter stream set runs far
# longer (risk reduction, NOT a fix — the upstream bug still exists). The companion
# connects ACTIVELY (udpout://10.41.10.1:14550, companion commit 08617bd) and uses
# MAVSDK, requesting its own stream rates, so Normal-vs-Onboard is functionally
# transparent for telemetry/logging. BROADCAST 0 (below) keeps broadcast OFF in
# Normal mode too, so the old MODE-0 wedge vector (broadcast sendto() on a link-down
# eth0 blocking in the ENET driver -> mavlink-eth wedged tx=0/txerr>0) CANNOT recur:
# the FMU latches the peer from the first RX packet and never broadcasts. The
# rover_can_bridge companion-loss watchdog is unaffected (keys on the companion->FMU
# heartbeat RX). See docs/HW_setup.md §8.1.
param set-default MAV_2_MODE      0
param set-default MAV_2_RATE      1000000
# Companion listens on UDP 14540 (rover_companion default).
param set-default MAV_2_REMOTE_PRT 14540
param set-default MAV_2_RADIO_CTL 0
# FORWARD 0: companion is the only real peer, nothing to relay. Forwarding copies
# every message received on another link into instance 2's TX path -> extra bytes
# AND extra on-stack serialize work in the mavlink_if<N> task (the same task that
# hardfaults). Off trims that load. (Was 1.)
param set-default MAV_2_FORWARD   0
# Broadcast=0: companion connects actively (udpout), so the FMU needs no
# broadcast. Keeping it off also prevents the link-down-eth0 broadcast wedge.
param set-default MAV_2_BROADCAST 0

# ── CAN bus + bridge (UAVCAN_ENABLE + CAN_BRIDGE_EN set above) ─────────
# MUST equal RA_MAX_STR_ANG (75°/1.31 rad). The bridge de-normalizes the
# [-1,1] steering setpoint by this to the angle sent to the VCU; a smaller
# value makes the VCU under-steer (was 0.5236 = 30° => 2.5× too wide a turn).
param set-default CAN_MAX_STR_ANG   1.31
param set-default ROV_CAN_SPD_EN    1

# VCU wheel-odometry feedback: motor RPM (MC_TPDO_03) -> body forward speed.
# v = (motor_rpm / ROV_GEAR_RED) * pi * ROV_WHL_DIAM / 60. Data sheet: wheel
# diameter 860 mm, reduction 150. Publish on; EKF2 fusion is opt-in via
# EKF2_EV_CTRL bit 2 (see docs/rover_tuning.md). On the SIH bench keep fusion
# off unless the VCU sim reports SIH-consistent speed.
param set-default ROV_ODO_EN        1
param set-default ROV_WHL_DIAM      0.86
param set-default ROV_GEAR_RED      150
param set-default ROV_ODO_NOISE     0.3

# ── Safety ─────────────────────────────────────────────────────────────
param set-default ROV_GNSS_PAUSE    1
param set-default ROV_RTK_MIN_FIX   6
param set-default ROV_GEO_EN        1
param set-default ROV_GEO_MARGIN    0.5
param set-default ROV_MISS_EN       1
param set-default ROV_MISS_DIST     5.0

# ── GPS offset (per-unit; provision_fmu.py overrides these) ────────────
param set-default ROV_GPS_OFF_EN    1
param set-default SENS_GPS0_OFFX    0.0
param set-default SENS_GPS0_OFFY    0.0
param set-default SENS_GPS0_OFFZ    0.0

# ── Dual ZED-F9P moving baseline (DRAFT — Topology A only) ─────────────
# Two F9P wired to FMU UARTs, PX4 drives the moving baseline and derives
# heading from the antenna pair (no magnetometer). LEAVE COMMENTED until
# the wiring topology is confirmed with the HW/VCU team (CONTEXT.md:1149):
#   - Topology A (both F9P on FMU) → uncomment this block.
#   - Topology B (F9P-to-F9P direct, one feeds FMU) → keep commented; the
#     receivers do the baseline themselves and PX4 reads a single GPS.
# Enabling GPS_2_CONFIG with only one F9P wired makes PX4 wait forever for
# the second receiver, so this MUST stay off until Topology A is verified.
#
# param set-default GPS_1_CONFIG    201          # primary F9P  → GPS1 port
# param set-default GPS_2_CONFIG    202          # secondary F9P → GPS2 port
# param set-default GPS_UBX_MODE    1            # 1 = heading (base+rover on FMU)
# param set-default GPS_YAW_OFFSET  90.0         # MEASURE: baseline angle vs body x (deg)
# param set-default EKF2_GPS_CTRL   15           # default 7 + bit3 (8) = GPS dual-antenna yaw
# param set-default EKF2_MAG_TYPE   5            # 5 = None (no magnetometer; yaw from GPS)
# Optional, only if F9P not auto-detected at default baud:
# param set-default SER_GPS1_BAUD   0            # 0 = auto
# param set-default SER_GPS2_BAUD   0            # 0 = auto
