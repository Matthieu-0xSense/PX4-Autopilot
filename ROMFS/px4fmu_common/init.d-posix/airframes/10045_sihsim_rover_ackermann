#!/bin/sh
# @name Rover Ackermann
# @type Rover
# @class Rover

. ${R}etc/init.d/rc.rover_ackermann_defaults

set VEHICLE_TYPE rover_ackermann
param set-default CA_AIRFRAME 5         # Rover (Ackermann)
param set-default CA_R_REV 1            # Motor is assumed to be reversible
param set-default EKF2_MAG_TYPE 1       # Make sure magnetometer is fused even when not driving
param set-default NAV_ACC_RAD 0.5       # Waypoint acceptance radius
param set-default EKF2_GBIAS_INIT 0.01
param set-default EKF2_ANGERR_INIT 0.01


PX4_SIMULATOR=${PX4_SIMULATOR:=sihsim}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=rover_ackermann}
PX4_GZ_MODEL_POSE=${PX4_GZ_MODEL_POSE:=0,0,0,0,0,-0.0472}

param set-default SIH_VEHICLE_TYPE 5 # sih as rover ackermann

param set-default PWM_MAIN_FUNC1 201 # Steering
param set-default PWM_MAIN_FUNC2 101 # Throttle
# 0xSense rover SIH physics (mirror of 51003 + bench_sih_config.txt). m=2850 (2.85T,
# data sheet 2026-06-16). L=2.825, W=H=1.5. Pairs with sih.cpp WHEEL_BASE 2.825 /
# MAX_STEER_ANGLE 75deg. SIH_KDV 1160 => full-throttle terminal
# sqrt((3700-0.05*2850*9.81)/1160) ~= 1.41 m/s == RO_MAX_THR_SPEED 1.4 so the
# speed feed-forward is self-consistent (was 12500 -> 1.85 m/s, a 1.85-vs-1.4
# plant/FF mismatch that over-sped SITL into pure-pursuit orbits).
# 2026-07-24: KDV 21000 -> 1160, pairs with the sih.cpp realistic-accel patch
# (MAX_THROTTLE_FORCE 50000->3700, MU_R 0.3->0.05): same terminal speed, launch
# accel capped ~0.81 m/s^2 (was ~17.5 available -> 1.85 m/s start spike).
param set-default SIH_MASS 2850
param set-default SIH_IXX 1069
param set-default SIH_IYY 2430
param set-default SIH_IZZ 2430
param set-default SIH_IXZ 0
param set-default SIH_KDV 1160
param set-default SIH_KDW 2850
param set-default SIH_LOC_LAT0 47.62399800296214
param set-default SIH_LOC_LON0 1.4193002806250288
param set-default SIH_LOC_YAW0 -150.0    # Initial heading: 60° left of North

param set-default SENS_EN_GPSSIM 1
param set-default SENS_EN_BAROSIM 1
param set-default SENS_EN_MAGSIM 1
# RTK-like sim GPS (rover runs RTK, ~2 cm). The upstream 0.8 m consumer-GPS
# noise model floored every SITL crosstrack at +/-0.3-0.5 m (missions 250/252:
# on-path xte was pure sim noise — sample-to-sample delta exceeded the signal).
param set-default SIM_GPS_PNOISE 0.02
# EKF observation floor must follow: with the default EKF2_GPS_P_NOISE 0.5 the
# EKF ignores the clean GPS and wanders 0.3-0.9 m off it (measured 2026-07-22);
# 0.1 (0.05 gate proved too tight — bench m254 position-emergency; see 51003)
# halves the EKF-vs-GPS error. NOTE: 51003 (real RTK,
# ~2 cm) also runs the 0.5 default -> same wander on the REAL rover; candidate
# field improvement, validate on bench first.
param set-default EKF2_GPS_P_NOISE 0.1

# Ackermann Parameters (0xSense rover tune, mirror of 51003 — data sheet:
# 75deg max steer, 2.825 m wheelbase, 4.9 km/h. min turn radius wb/tan75 ~0.76 m)
param set-default RA_WHEEL_BASE 2.825
param set-default RA_ACC_RAD_GAIN 2
param set-default RA_ACC_RAD_MAX 1.0
param set-default RA_MAX_STR_ANG 1.31
# 45 deg/s = real hydraulic steering slew (lock-to-lock ~3 s), mirror of
# 51003. The old 360 was effectively unlimited: instant 75° steering steps
# make the SIH plant's yaw accel spike, and the omega x r GPS lever-arm term
# then outruns the 8 Hz GPS -> EKF velocity-innovation stress -> position
# resets at headland turns (mission 269).
param set-default RA_STR_RATE_LIM 45

# Rate Control Parameters
param set-default RO_YAW_RATE_I 0.02
param set-default RO_YAW_RATE_P 0.3
# RO_YAW_RATE_LIM 45 (was 90): this param FLOORS cornering speed —
# AckermannPosControl/AutoMode clamp all corner slowdown (RO_SPEED_RED paths)
# to min_speed = RA_WHEEL_BASE * RO_YAW_RATE_LIM / tan(RA_MAX_STR_ANG). At 90
# that floor is 1.19 m/s vs 1.3 cruise, so hairpins were entered near full
# speed (turn xte peaks 1.2-1.5 m). 60 -> 0.79 m/s floor. 2026-07-22: 45 was
# tried first (best on sparse synthetic corners) but STALLS on production
# dense-arc plans (mission 250 replay: start deadlock; arcs need >45 deg/s at
# cruise) -> 60. 2026-07-21 sweep data (45):
# corner peaks 1.21 -> 0.48-0.82 m (boustro), 1.23 -> 0.68-0.86 m (hairpin).
# Do NOT go lower: the yaw-rate cap then widens turn ENTRY (radius = v/cap;
# 30 deg/s measured worse). At any value, radius at floor speed = wb/tan(75)
# = 0.76 m = min turn radius by construction.
param set-default RO_YAW_RATE_LIM 60
param set-default RO_YAW_ACCEL_LIM 80
param set-default RO_YAW_DECEL_LIM 80
param set-default RO_YAW_RATE_CORR 1

# Attitude Control Parameters
param set-default RO_YAW_P 1.0

# Velocity Control Parameters
param set-default RO_ACCEL_LIM 0.5
param set-default RO_DECEL_LIM 0.5
param set-default RO_JERK_LIM 10
param set-default RO_MAX_THR_SPEED 1.4
param set-default RO_SPEED_LIM 1.3
# Speed loop must be CLOSED (was P/I 0.001 = pure feed-forward). With KDV now
# matched so the plant terminal == RO_MAX_THR_SPEED the FF is self-consistent,
# but P/I 0.5 regulates out any residual (mirror of 51003 + bench_sih_config).
param set-default RO_SPEED_I 0.5
param set-default RO_SPEED_P 0.5
param set-default RO_SPEED_RED 2.5

# Pure Pursuit parameters. PP_LOOKAHD_MIN 1.0 (was 5.0 >> 2-3 m waypoint spacing
# -> the rover circled the aim point instead of acquiring it; 51003/bench use 1.0).
# GAIN 1.5 (was 2.0): 2026-06-30 sweep picked it — turn-tracking rms -21% vs 2.0,
# best objective; <=1.0 regresses. Mirror of 51003.
param set-default PP_LOOKAHD_GAIN 1.5
param set-default PP_LOOKAHD_MAX 12
# MIN 0.7 (was 1.0): with RO_YAW_RATE_LIM 45 the turn-zone speed is ~0.6 m/s,
# where lookahead = GAIN*v ~= 0.9 m, so MIN 1.0 was the binding clamp in turns.
# 0.7 lets the speed-scaled lookahead through -> tighter U-turn tracking
# (2026-07-21 sweep; 0.5 regresses straights — low-speed weave).
param set-default PP_LOOKAHD_MIN 0.7

# Companion-loss failsafe (see robot_nav/docs/safety.md §1.1)
# Backup path: PX4 commander datalink failsafe — Hold/Loiter on GCS loss
# after COM_DL_LOSS_T (5 s minimum). The bridge fast watchdog is the
# primary path with a ≤500 ms target.
param set-default COM_DL_LOSS_T 5
param set-default NAV_DLL_ACT 1
param set-default ROV_DLL_EN 1
param set-default ROV_DLL_LOSS_MS 500
param set-default ROV_SP_STALE_MS 150
