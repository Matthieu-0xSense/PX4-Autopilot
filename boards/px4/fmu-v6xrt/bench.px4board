CONFIG_MODULES_SIMULATION_SENSOR_MAG_SIM=y
# Bench coverage missions exceed the dataman default (500). Match the
# `default` board's 10000 so large field plans upload to PX4.
# (rover.px4board leaves the 500 default — see docs/test.md Layer 4c.)
CONFIG_NUM_MISSION_ITMES_SUPPORTED=10000
